/* =======================
   ESTILO GENERAL - TEMA CLARO
======================= */

* {
    font-family: "Segoe UI", Arial;
    font-size: 13px;
}

/* Fondo general */
QMainWindow, QWidget {
    background-color: #f5f6fa;
    color: #2f3640;
}

/* =======================
   LABELS
======================= */

QLabel {
    color: #2f3640;
    padding: 2px;
}

/* Títulos */
QLabel#titulo {
    font-size: 17px;
    font-weight: bold;
    color: #2f3640;
}

/* =======================
   BOTONES
======================= */

QPushButton {
    background-color: #ffffff;
    color: #2f3640;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    height: 36px;
    padding: 0 14px;
}

QPushButton:hover {
    background-color: #e8f1fb;
    border-color: #0078d4;
}

QPushButton:pressed {
    background-color: #dbeafe;
}

QPushButton:disabled {
    background-color: #f1f2f6;
    color: #a4b0be;
}

/* Botón principal */
QPushButton#primary {
    background-color: #0078d4;
    color: white;
    border: none;
}

QPushButton#primary:hover {
    background-color: #0063b1;
}

/* =======================
   INPUTS
======================= */

QLineEdit, QTextEdit {
    background-color: #ffffff;
    color: #2f3640;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    height: 36px;
    padding: 6px 8px;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #0078d4;
}

/* =======================
   COMBOBOX
======================= */

QComboBox {
    background-color: #ffffff;
    color: #2f3640;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    height: 36px;
    padding-left: 8px;
}

QComboBox:hover {
    border: 1px solid #0078d4;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    selection-background-color: #e8f1fb;
}

/* =======================
   TABLAS
======================= */

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #dcdde1;
    gridline-color: #dcdde1;
}

QHeaderView::section {
    background-color: #f1f2f6;
    color: #2f3640;
    padding: 6px;
    border: 1px solid #dcdde1;
}

QTableWidget::item:selected {
    background-color: #e8f1fb;
}

/* =======================
   SCROLLBAR
======================= */

QScrollBar:vertical {
    background: #f5f6fa;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #ced6e0;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #0078d4;
}
