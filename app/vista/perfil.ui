   <string>
QWidget {
    background-color: #121212;
    color: #eaeaea;
    font-family: Segoe UI;
}

QLabel#labelTitulo {
    color: #00c853;
}

QLineEdit, QDateEdit {
    background-color: #1e1e1e;
    border: 2px solid #2e2e2e;
    border-radius: 8px;
    padding: 8px;
}

QLineEdit:focus, QDateEdit:focus {
    border: 2px solid #00c853;
}

QPushButton {
    background-color: #00c853;
    border-radius: 10px;
    padding: 10px;
    font-weight: bold;
    color: #000000;
}

QPushButton:hover {
    background-color: #00e676;
}

QPushButton#btnEliminarCuenta {
    background-color: #2a1e1e;
    border: 2px solid #ff5252;
    color: #ff5252;
}

QPushButton#btnEliminarCuenta:hover {
    background-color: #ff5252;
    color: #000000;
}
   </string>
